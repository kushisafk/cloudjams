# PostgreSQL connection string (Prisma Postgres pooled or direct URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Resend API secret key (server-only — https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender address configured in Resend (e.g. "GDG on Campus IARE <studyjams@yourdomain.com>" or "onboarding@resend.dev" for testing)
EMAIL_FROM="GDG on Campus IARE <onboarding@resend.dev>"

# Public base URL used for QR code links (e.g. https://your-project.vercel.app in production, http://localhost:8080 locally)
APP_BASE_URL="http://localhost:8080"
