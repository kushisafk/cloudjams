# PostgreSQL connection string (Prisma Postgres pooled or direct URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Google Cloud OAuth 2.0 Client credentials (server-only — https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Exact OAuth 2.0 Redirect URI registered in Google Cloud Console
# Local: http://localhost:8080/api/auth/google/callback
# Production: https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:8080/api/auth/google/callback"

# OAuth 2.0 Refresh Token for Gmail API (scope: https://www.googleapis.com/auth/gmail.send)
GMAIL_REFRESH_TOKEN="your-gmail-oauth-refresh-token"

# Authenticated Gmail mailbox address used to send confirmation emails
GMAIL_SENDER_EMAIL="your-sender-account@gmail.com"

# Optional sender display name shown in email inboxes (defaults to "(FAKE) GDG on Campus at IARE")
GMAIL_SENDER_NAME="(FAKE) GDG on Campus at IARE"

# Public base URL used for QR code links (e.g. https://your-project.vercel.app in production, http://localhost:8080 locally)
APP_BASE_URL="http://localhost:8080"
