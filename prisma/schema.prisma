generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Registration {
  id                 String              @id @default(cuid())
  playerCode         String              @unique
  qrToken            String              @unique @default(cuid())
  fullName           String
  rollNumber         String              @default("")
  collegeEmail       String              @unique
  collegeName        String
  yearOfStudy        String
  branch             String
  phone              String?
  usedGcp            String?
  experienceLevel    String?
  cloudInterest      String?
  consent            Boolean             @default(false)
  status             RegistrationStatus  @default(REGISTERED)
  emailStatus        EmailDeliveryStatus @default(PENDING)
  emailSentAt        DateTime?
  emailMessageId     String?
  emailError         String?
  emailAttempts      Int                 @default(0)
  lastEmailAttemptAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([collegeEmail])
  @@index([qrToken])
  @@index([emailStatus])
  @@index([createdAt])
}
